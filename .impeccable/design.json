  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action of a region: New room, Create room.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>New room</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 14px;border-radius:8px;border:1px solid #D8CFC7;background:#FFFFFF;color:#2A1C13;font:500 13.5px/1.45 Poppins,'Kantumruy Pro',system-ui,sans-serif;cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease,transform 120ms ease}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid #991B1B;outline-offset:2px}.ds-btn[disabled]{opacity:0.45;cursor:not-allowed;transform:none}.ds-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-btn-primary{background:#991B1B;border-color:#991B1B;color:#FFFFFF}.ds-btn-primary:hover{background:#7F1D1D;border-color:#7F1D1D}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ordinary actions: Edit, Clear filters.",
      "html": "<button class=\"ds-btn\">Edit</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 14px;border-radius:8px;border:1px solid #D8CFC7;background:#FFFFFF;color:#2A1C13;font:500 13.5px/1.45 Poppins,'Kantumruy Pro',system-ui,sans-serif;cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease,transform 120ms ease}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid #991B1B;outline-offset:2px}.ds-btn[disabled]{opacity:0.45;cursor:not-allowed;transform:none}.ds-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-btn:hover{border-color:#6B5243}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Cancel, Keep on, More filters.",
      "html": "<button class=\"ds-btn ds-btn-quiet\">Cancel</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 14px;border-radius:8px;border:1px solid #D8CFC7;background:#FFFFFF;color:#2A1C13;font:500 13.5px/1.45 Poppins,'Kantumruy Pro',system-ui,sans-serif;cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease,transform 120ms ease}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid #991B1B;outline-offset:2px}.ds-btn[disabled]{opacity:0.45;cursor:not-allowed;transform:none}.ds-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-btn-quiet{background:transparent;border-color:transparent;color:#6B5243}.ds-btn-quiet:hover{background:#F7ECEA;color:#991B1B}"
    },
    {
